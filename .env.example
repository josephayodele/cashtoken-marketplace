# Cashtoken VAS API — used by src/lib/cashtokenApi.ts for IDP sign-in.
#
# Local dev:  copy this file to `.env.local` and fill in VITE_CASHTOKEN_API_KEY.
#             The Vite proxy (vite.config.ts) handles CORS for /idp/* and /api/*.
#
# Production: set VITE_CASHTOKEN_API_KEY in your hosting platform's env vars
#             (e.g. Vercel project settings). Routing is handled by rewrites
#             in vercel.json; leave VITE_CASHTOKEN_API_BASE unset so the
#             client uses relative paths.

# Required — your Cashtoken sandbox/production API key.
VITE_CASHTOKEN_API_KEY=your-api-key-here

# Optional override — only set if you're NOT using a same-origin proxy/rewrite.
# Leaving this empty makes the client use relative paths (recommended).
# VITE_CASHTOKEN_API_BASE=https://vasapi-sandbox.cashtoken.africa

# Optional — pre-issued QA bearer token from the Postman env. Currently unused
# by the app; kept as a reference for the BEARER_TOKEN variable name.
VITE_CASHTOKEN_QA_BEARER_TOKEN=
