{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/idp/:path*",
      "destination": "https://vasapi-sandbox.cashtoken.africa/idp/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vasapi-sandbox.cashtoken.africa/api/:path*"
    },
    {
      "source": "/coreapi/:path*",
      "destination": "https://api-sandbox.cashtoken.africa/v2/:path*"
    },
    {
      "source": "/((?!_next|static|favicon\\.ico|logos|images|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
